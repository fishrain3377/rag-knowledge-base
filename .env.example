# =============================================================
# 环境变量配置（复制为 .env 后填写）
# .env 已被 .gitignore 忽略，不会入库
# =============================================================

# 必填：LLM API Key（DeepSeek / OpenAI / 通义 / Kimi 等任意 OpenAI 兼容服务）
OPENAI_API_KEY=

# 服务商兼容接口地址（按服务商文档填写）
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 模型名
LLM_MODEL=deepseek-chat

# HuggingFace 镜像（国内网络下载 embedding 模型用，默认已内置 hf-mirror）
HF_ENDPOINT=https://hf-mirror.com
